/target
/.worktrees/
/.claude/
**/*.rs.bk
Cargo.lock.bak
*.swp
.DS_Store
/examples/openraft-cluster/.data/
/examples/embedded-server/tsoracle-embedded-data/
/examples/metrics-prometheus/tsoracle-prometheus-data/
# Default `tsoracle serve --state-dir` target, written when the binary is run
# from the workspace root. The LOCK sentinel acquired by FileDriver::open_or_init
# lives here too.
/tsoracle-data/
/lcov.info

# bench-minimal flamegraph artifacts (written to CWD by the bench binary
# when run with --features flamegraph; never tracked).
tracing.folded
flamegraph.svg
# bench-throughput-sweep writes one JSON per client count; ignore them.
/bench-*.json

# Only track root-level markdown under docs/; ignore everything else
# (subdirectories, generated artifacts, scratch files).
docs/*
!docs/*.md

# Zola site build output
site/public/
site/static/giallo-*.css
/.playwright-mcp/
/audit-*.png
/verify-*.png