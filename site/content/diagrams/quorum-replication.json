    "annotations": [
        {"t": 0,    "text": "Term 2. Leader N1 wants to advance hwm to 16. Appends to its log, fsyncs."},
        {"t": 800,  "text": "Sends AppendEntries(hwm=16) to N2 and N3."},
        {"t": 1900, "text": "N2 writes to its log, acks. Leader has quorum (self + N2 of 3 = 2/3)."},
        {"t": 3200, "text": "N3 also acks. All replicas now have the entry."},
        {"t": 4500, "text": "Commit notice propagates. hwm = 16 is durable across the cluster."}
