#!/usr/bin/env bash
# Pre-commit hook: blocks the commit unless `cargo fmt --check` and clippy pass.
#
# Auto-installed by husky-rs (a dev-dependency of `tsoracle-core`) on the first
# `cargo test` of this clone — husky-rs sets `core.hooksPath = .husky`, after
# which git uses this script directly. Manual install: `make install-hooks`.
# Bypass intentionally with `git commit --no-verify`. CI runs the same checks
# regardless, so a bypassed commit will still be caught upstream.

set -euo pipefail

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy"
cargo clippy --workspace --all-targets --all-features -- -D warnings
