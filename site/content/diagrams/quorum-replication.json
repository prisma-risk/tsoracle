    "nodes": ["N1", "N2", "N3"],
    "duration": 7500,
    "events": [
        {"t": 0,    "type": "term",    "term": 2},
        {"t": 0,    "type": "state",   "node": "N1", "state": "leader"},
        {"t": 0,    "type": "state",   "node": "N2", "state": "follower"},
        {"t": 0,    "type": "state",   "node": "N3", "state": "follower"},

        {"t": 800,  "type": "message", "from": "N1", "to": "N2", "label": "AppendEntries(hwm=16)"},
        {"t": 800,  "type": "message", "from": "N1", "to": "N3", "label": "AppendEntries(hwm=16)"},

        {"t": 1900, "type": "message", "from": "N2", "to": "N1", "label": "Ack", "kind": "reply"},

        {"t": 3200, "type": "message", "from": "N3", "to": "N1", "label": "Ack", "kind": "reply"},

        {"t": 4500, "type": "message", "from": "N1", "to": "N2", "label": "Commit(hwm=16)"},
        {"t": 4500, "type": "message", "from": "N1", "to": "N3", "label": "Commit(hwm=16)"}
